# Contoh konfigurasi Integra Commander CLI.
# File asli: /etc/integra-commander/commander.conf (root-only, 600).
# Jangan menaruh file ini di lokasi yang bisa dibaca user lain.
#
# APP_USER      : user Linux pemilik aplikasi (bukan root)
# APP_DIR       : folder dasar; services/temp/public dibuat langsung di sini
# SERVER_IP     : IP yang dipakai frontend untuk memanggil backend
# APP_MODE      : production | development
# RANGE_TRANSACTION : last_1_week | last_month | last_3_month | last_6_month | all

APP_NAME='API_CORE_MERTRACK'
APP_USER='merindo'
APP_DIR='/home/merindo/mertrack'
SERVER_IP='192.168.1.10'
APP_TIMEZONE='Asia/Jakarta'
APP_MODE='production'
LOGIN_TIMEOUT='15'
RANGE_TRANSACTION='last_1_week'

BACKEND_PORT='8001'
BACKEND_BRANCH=''
FRONTEND_PORT='8000'
FRONTEND_BRANCH=''

DB_DIALECT='postgres'
DB_HOST='127.0.0.1'
DB_PORT='5432'
DB_NAME='mertrack'
DB_USER='mertrack'
DB_PASSWORD=''

BPOM_URL='https://ttacdev.pom.go.id/dev/public/api/v3/'
BPOM_EMAIL=''
BPOM_PASSWORD=''
BPOM_APP_NAME='CONNECTOR_BPOM'
BPOM_APP_PORT='8002'

CORE_REPO='https://gitlab.com/mertrack/mertrack-core'
FRONTEND_REPO='https://gitlab.com/mertrack/mertrack_frontend'
BPOM_REPO='https://gitlab.com/gesang/connector-bpom'

NGINX_SITE_NAME='mertrack_frontend'
NGINX_SERVER_NAME='_'
